<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ASIS1" targetNamespace="http://peluditospetchile.cl/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <collaboration id="Colab_ASIS1">
    <participant id="P_Cliente" name="Cliente" processRef="Proc_Cliente" />
    <participant id="P_Peluditos" name="Peluditos Pet Chile" processRef="Proc_Peluditos" />
    <messageFlow id="M1" name="Consulta" sourceRef="C_Consulta" targetRef="E_Inicio" />
    <messageFlow id="M2" name="Precios y opciones" sourceRef="E_Responder" targetRef="C_RecibeInfo" />
    <messageFlow id="M3" name="Pedido y comprobante" sourceRef="C_Confirmar" targetRef="E_Confirmacion" />
    <messageFlow id="M4" name="Pedido" sourceRef="E_Entregar" targetRef="C_RecibePedido" />
    <textAnnotation id="A1">
      <text>Dolor: el perfil no tiene enlace directo a WhatsApp; el cliente debe copiar el número</text>
    </textAnnotation>
    <textAnnotation id="A2">
      <text>Dolor: si el cliente no responde, no se vuelve a contactar ni se registra el motivo</text>
    </textAnnotation>
    <textAnnotation id="A3">
      <text>Dolor: no se registra al cliente ni a su mascota para futuras compras</text>
    </textAnnotation>
    <association id="As1" sourceRef="E_Leer" targetRef="A1" />
    <association id="As2" sourceRef="E_FinSinSeguimiento" targetRef="A2" />
    <association id="As3" sourceRef="E_FinVenta" targetRef="A3" />
  </collaboration>
  <process id="Proc_Cliente" isExecutable="false">
    <startEvent id="C_Inicio" name="Necesita un producto para su mascota" />
    <task id="C_Consulta" name="Enviar consulta por mensaje directo, teléfono o tienda web" />
    <intermediateCatchEvent id="C_RecibeInfo" name="Información recibida">
      <messageEventDefinition />
    </intermediateCatchEvent>
    <exclusiveGateway id="C_Gw" name="¿Le interesa comprar?" />
    <task id="C_Confirmar" name="Confirmar pedido y transferir pago" />
    <intermediateCatchEvent id="C_RecibePedido" name="Pedido recibido">
      <messageEventDefinition />
    </intermediateCatchEvent>
    <endEvent id="C_FinCompra" name="Compra realizada" />
    <endEvent id="C_FinNoCompra" name="No compra" />
    <sequenceFlow id="cf1" sourceRef="C_Inicio" targetRef="C_Consulta" />
    <sequenceFlow id="cf2" sourceRef="C_Consulta" targetRef="C_RecibeInfo" />
    <sequenceFlow id="cf3" sourceRef="C_RecibeInfo" targetRef="C_Gw" />
    <sequenceFlow id="cf4" name="Sí" sourceRef="C_Gw" targetRef="C_Confirmar" />
    <sequenceFlow id="cf5" name="No" sourceRef="C_Gw" targetRef="C_FinNoCompra" />
    <sequenceFlow id="cf6" sourceRef="C_Confirmar" targetRef="C_RecibePedido" />
    <sequenceFlow id="cf7" sourceRef="C_RecibePedido" targetRef="C_FinCompra" />
  </process>
  <process id="Proc_Peluditos" isExecutable="false">
    <laneSet id="LS1">
      <lane id="L_Emprendedora" name="Emprendedora">
        <flowNodeRef>E_Inicio</flowNodeRef>
        <flowNodeRef>E_Leer</flowNodeRef>
        <flowNodeRef>E_Responder</flowNodeRef>
        <flowNodeRef>E_GwEvento</flowNodeRef>
        <flowNodeRef>E_Confirmacion</flowNodeRef>
        <flowNodeRef>E_SinRespuesta</flowNodeRef>
        <flowNodeRef>E_Verificar</flowNodeRef>
        <flowNodeRef>E_Elaborar</flowNodeRef>
        <flowNodeRef>E_Entregar</flowNodeRef>
        <flowNodeRef>E_FinVenta</flowNodeRef>
        <flowNodeRef>E_FinSinSeguimiento</flowNodeRef>
      </lane>
    </laneSet>
    <dataStoreReference id="DS_Chats" name="Chats de redes sociales" />
    <startEvent id="E_Inicio" name="Consulta recibida">
      <messageEventDefinition />
    </startEvent>
    <task id="E_Leer" name="Leer consulta en la red social" />
    <task id="E_Responder" name="Responder precios, sabores y disponibilidad">
      <dataOutputAssociation id="DOA1">
        <targetRef>DS_Chats</targetRef>
      </dataOutputAssociation>
    </task>
    <eventBasedGateway id="E_GwEvento" name="¿Responde el cliente?" />
    <intermediateCatchEvent id="E_Confirmacion" name="Pedido y comprobante recibidos">
      <messageEventDefinition />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="E_SinRespuesta" name="Cliente deja de responder">
      <timerEventDefinition />
    </intermediateCatchEvent>
    <task id="E_Verificar" name="Verificar transferencia" />
    <task id="E_Elaborar" name="Elaborar torta" />
    <task id="E_Entregar" name="Coordinar y realizar entrega" />
    <endEvent id="E_FinVenta" name="Venta concretada" />
    <endEvent id="E_FinSinSeguimiento" name="Consulta queda sin seguimiento" />
    <sequenceFlow id="ef1" sourceRef="E_Inicio" targetRef="E_Leer" />
    <sequenceFlow id="ef2" sourceRef="E_Leer" targetRef="E_Responder" />
    <sequenceFlow id="ef3" sourceRef="E_Responder" targetRef="E_GwEvento" />
    <sequenceFlow id="ef4" sourceRef="E_GwEvento" targetRef="E_Confirmacion" />
    <sequenceFlow id="ef5" sourceRef="E_GwEvento" targetRef="E_SinRespuesta" />
    <sequenceFlow id="ef6" sourceRef="E_Confirmacion" targetRef="E_Verificar" />
    <sequenceFlow id="ef10" sourceRef="E_SinRespuesta" targetRef="E_FinSinSeguimiento" />
    <sequenceFlow id="ef7" sourceRef="E_Verificar" targetRef="E_Elaborar" />
    <sequenceFlow id="ef8" sourceRef="E_Elaborar" targetRef="E_Entregar" />
    <sequenceFlow id="ef9" sourceRef="E_Entregar" targetRef="E_FinVenta" />
  </process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="Colab_ASIS1">
