<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ASIS" targetNamespace="http://peluditospetchile.cl/bpmn">
  <category id="Cat_Procesos">
    <categoryValue id="CV_P1" value="Proceso 1: Atención de consultas"/>
    <categoryValue id="CV_P2" value="Proceso 2: Recontacto en fechas especiales"/>
  </category>
  <collaboration id="Colab_ASIS">
    <participant id="P_Cliente" name="Cliente" processRef="Proc_Cliente"/>
    <participant id="P_Peluditos" name="Peluditos Pet Chile" processRef="Proc_Peluditos"/>
    <participant id="P_Seguidores" name="Clientes y seguidores"/>
    <messageFlow id="M1" name="Consulta" sourceRef="C_Consulta" targetRef="E_Inicio"/>
    <messageFlow id="M2" name="Precios y opciones" sourceRef="E_Responder" targetRef="C_RecibeInfo"/>
    <messageFlow id="M3" name="Pedido y comprobante" sourceRef="C_Confirmar" targetRef="E_Confirmacion"/>
    <messageFlow id="M4" name="Pedido" sourceRef="E_Entregar" targetRef="C_RecibePedido"/>
    <messageFlow id="M21" name="Mensaje con promoción" sourceRef="R_Mensajes" targetRef="P_Seguidores"/>
    <messageFlow id="M22" name="Nuevas consultas" sourceRef="P_Seguidores" targetRef="R_Responder"/>
    <group id="G1" categoryValueRef="CV_P1"/>
    <group id="G2" categoryValueRef="CV_P2"/>
    <textAnnotation id="A0"><text>Dolor: el perfil no tiene enlace directo a WhatsApp; el cliente debe copiar el número</text></textAnnotation>
    <textAnnotation id="A1"><text>Dolor: no se registra la consulta ni el canal de origen</text></textAnnotation>
    <textAnnotation id="A2"><text>Dolor: si el cliente no responde, no se vuelve a contactar ni se registra el motivo</text></textAnnotation>
    <textAnnotation id="A3"><text>Dolor: no se registra al cliente ni a su mascota para futuras compras</text></textAnnotation>
    <textAnnotation id="A21"><text>Dolor: depende de la memoria de la emprendedora; no hay registro de fechas ni de cumpleaños de mascotas.
Evidencia (Instagram, 17-oct): se celebran cumpleaños de mascotas, pero no hay campaña de Halloween.</text></textAnnotation>
    <textAnnotation id="A22"><text>Las consultas generadas siguen el Proceso 1 (sin registro ni seguimiento)</text></textAnnotation>
    <textAnnotation id="A23"><text>Dolor: no se mide cuántas ventas genera cada campaña</text></textAnnotation>
    <textAnnotation id="A24"><text>Dolor: publicaciones esporádicas y sin planificación; no existe un calendario de campañas</text></textAnnotation>
    <association id="As0" sourceRef="C_Consulta" targetRef="A0"/>
    <association id="As1" sourceRef="E_Leer" targetRef="A1"/>
    <association id="As2" sourceRef="E_FinSinSeguimiento" targetRef="A2"/>
    <association id="As3" sourceRef="E_FinVenta" targetRef="A3"/>
    <association id="As21" sourceRef="R_Inicio" targetRef="A21"/>
    <association id="As22" sourceRef="R_Responder" targetRef="A22"/>
    <association id="As23" sourceRef="R_Fin" targetRef="A23"/>
    <association id="As24" sourceRef="R_Publicar" targetRef="A24"/>
  </collaboration>

  <process id="Proc_Cliente" isExecutable="false">
    <startEvent id="C_Inicio" name="Necesita un producto para su mascota"/>
    <task id="C_Consulta" name="Enviar consulta por mensaje directo, teléfono o tienda web"/>
    <intermediateCatchEvent id="C_RecibeInfo" name="Información recibida"><messageEventDefinition/></intermediateCatchEvent>
    <exclusiveGateway id="C_Gw" name="¿Le interesa comprar?"/>
    <task id="C_Confirmar" name="Confirmar pedido y transferir pago"/>
    <intermediateCatchEvent id="C_RecibePedido" name="Pedido recibido"><messageEventDefinition/></intermediateCatchEvent>
    <endEvent id="C_FinCompra" name="Compra realizada"/>
    <endEvent id="C_FinNoCompra" name="No compra"/>
    <sequenceFlow id="cf1" sourceRef="C_Inicio" targetRef="C_Consulta"/>
    <sequenceFlow id="cf2" sourceRef="C_Consulta" targetRef="C_RecibeInfo"/>
    <sequenceFlow id="cf3" sourceRef="C_RecibeInfo" targetRef="C_Gw"/>
    <sequenceFlow id="cf4" name="Sí" sourceRef="C_Gw" targetRef="C_Confirmar"/>
    <sequenceFlow id="cf5" name="No" sourceRef="C_Gw" targetRef="C_FinNoCompra"/>
    <sequenceFlow id="cf6" sourceRef="C_Confirmar" targetRef="C_RecibePedido"/>
    <sequenceFlow id="cf7" sourceRef="C_RecibePedido" targetRef="C_FinCompra"/>
  </process>

  <process id="Proc_Peluditos" isExecutable="false">
    <laneSet id="LS1"><lane id="L_Emprendedora" name="Emprendedora">
      <flowNodeRef>E_Inicio</flowNodeRef><flowNodeRef>E_Leer</flowNodeRef><flowNodeRef>E_Responder</flowNodeRef>
      <flowNodeRef>E_GwEvento</flowNodeRef><flowNodeRef>E_Confirmacion</flowNodeRef><flowNodeRef>E_SinRespuesta</flowNodeRef>
      <flowNodeRef>E_Verificar</flowNodeRef><flowNodeRef>E_Preparar</flowNodeRef><flowNodeRef>E_Entregar</flowNodeRef>
      <flowNodeRef>E_FinVenta</flowNodeRef><flowNodeRef>E_FinSinSeguimiento</flowNodeRef>
      <flowNodeRef>R_Inicio</flowNodeRef><flowNodeRef>R_Buscar</flowNodeRef><flowNodeRef>R_Gw</flowNodeRef>
      <flowNodeRef>R_Publicar</flowNodeRef><flowNodeRef>R_Mensajes</flowNodeRef><flowNodeRef>R_Join</flowNodeRef>
      <flowNodeRef>R_Responder</flowNodeRef><flowNodeRef>R_Fin</flowNodeRef>
    </lane></laneSet>
    <dataStoreReference id="DS_Chats" name="Chats de redes sociales"/>
    <dataStoreReference id="DS2_Chats" name="Chats e historial de redes sociales"/>

    <!-- Proceso 1: Atención de consultas -->
    <startEvent id="E_Inicio" name="Consulta recibida"><messageEventDefinition/></startEvent>
    <task id="E_Leer" name="Leer consulta recibida"/>
    <task id="E_Responder" name="Responder precios, opciones y disponibilidad">
      <dataOutputAssociation id="DOA1"><targetRef>DS_Chats</targetRef></dataOutputAssociation>
    </task>
    <eventBasedGateway id="E_GwEvento" name="¿Responde el cliente?"/>
    <intermediateCatchEvent id="E_Confirmacion" name="Pedido y comprobante recibidos"><messageEventDefinition/></intermediateCatchEvent>
    <intermediateCatchEvent id="E_SinRespuesta" name="Cliente deja de responder"><timerEventDefinition/></intermediateCatchEvent>
    <task id="E_Verificar" name="Verificar transferencia"/>
    <task id="E_Preparar" name="Preparar pedido"/>
    <task id="E_Entregar" name="Coordinar y realizar entrega"/>
    <endEvent id="E_FinVenta" name="Venta concretada"/>
    <endEvent id="E_FinSinSeguimiento" name="Consulta queda sin seguimiento"/>
    <sequenceFlow id="ef1" sourceRef="E_Inicio" targetRef="E_Leer"/>
    <sequenceFlow id="ef2" sourceRef="E_Leer" targetRef="E_Responder"/>
    <sequenceFlow id="ef3" sourceRef="E_Responder" targetRef="E_GwEvento"/>
    <sequenceFlow id="ef4" sourceRef="E_GwEvento" targetRef="E_Confirmacion"/>
    <sequenceFlow id="ef5" sourceRef="E_GwEvento" targetRef="E_SinRespuesta"/>
    <sequenceFlow id="ef6" sourceRef="E_Confirmacion" targetRef="E_Verificar"/>
    <sequenceFlow id="ef7" sourceRef="E_Verificar" targetRef="E_Preparar"/>
    <sequenceFlow id="ef8" sourceRef="E_Preparar" targetRef="E_Entregar"/>
    <sequenceFlow id="ef9" sourceRef="E_Entregar" targetRef="E_FinVenta"/>
    <sequenceFlow id="ef10" sourceRef="E_SinRespuesta" targetRef="E_FinSinSeguimiento"/>

    <!-- Proceso 2: Recontacto en fechas especiales -->
    <startEvent id="R_Inicio" name="Recuerda una fecha especial"/>
    <task id="R_Buscar" name="Buscar clientes anteriores en chats y seguidores">
      <property id="R_Buscar_prop" name="__targetRef_placeholder"/>
      <dataInputAssociation id="DIA2"><sourceRef>DS2_Chats</sourceRef><targetRef>R_Buscar_prop</targetRef></dataInputAssociation>
    </task>
    <exclusiveGateway id="R_Gw" name="¿Cómo difundir?"/>
    <task id="R_Publicar" name="Publicar promoción en redes sociales"/>
    <task id="R_Mensajes" name="Enviar mensajes uno a uno por WhatsApp"/>
    <exclusiveGateway id="R_Join"/>
    <task id="R_Responder" name="Responder consultas de interesados"/>
    <endEvent id="R_Fin" name="Campaña realizada"/>
    <sequenceFlow id="rf1" sourceRef="R_Inicio" targetRef="R_Buscar"/>
    <sequenceFlow id="rf2" sourceRef="R_Buscar" targetRef="R_Gw"/>
    <sequenceFlow id="rf3" name="Público general" sourceRef="R_Gw" targetRef="R_Publicar"/>
    <sequenceFlow id="rf4" name="Clientes conocidos" sourceRef="R_Gw" targetRef="R_Mensajes"/>
    <sequenceFlow id="rf5" sourceRef="R_Publicar" targetRef="R_Join"/>
    <sequenceFlow id="rf6" sourceRef="R_Mensajes" targetRef="R_Join"/>
    <sequenceFlow id="rf7" sourceRef="R_Join" targetRef="R_Responder"/>
    <sequenceFlow id="rf8" sourceRef="R_Responder" targetRef="R_Fin"/>
  </process>

  <bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="Colab_ASIS">
    <bpmndi:BPMNShape id="P_Cliente_di" bpmnElement="P_Cliente" isHorizontal="true"><dc:Bounds x="50" y="40" width="1500" height="220"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_Peluditos_di" bpmnElement="P_Peluditos" isHorizontal="true"><dc:Bounds x="50" y="300" width="1500" height="700"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Emprendedora_di" bpmnElement="L_Emprendedora" isHorizontal="true"><dc:Bounds x="80" y="300" width="1470" height="700"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_Seguidores_di" bpmnElement="P_Seguidores" isHorizontal="true"><dc:Bounds x="50" y="1040" width="1500" height="60"/></bpmndi:BPMNShape>

    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1"><dc:Bounds x="200" y="320" width="1335" height="300"/><bpmndi:BPMNLabel><dc:Bounds x="285" y="326" width="260" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
