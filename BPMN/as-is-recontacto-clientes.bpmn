<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ASIS2" targetNamespace="http://peluditospetchile.cl/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <collaboration id="Colab_ASIS2">
    <participant id="P2_Peluditos" name="Peluditos Pet Chile" processRef="Proc2_Peluditos" />
    <participant id="P2_Clientes" name="Clientes y seguidores" />
    <messageFlow id="M21" name="Mensaje con promoción" sourceRef="R_Mensajes" targetRef="P2_Clientes" />
    <messageFlow id="M22" name="Nuevas consultas" sourceRef="P2_Clientes" targetRef="R_Responder" />
    <textAnnotation id="A21">
      <text>Dolor: depende de la memoria de la emprendedora; no hay registro de fechas ni de cumpleaños de mascotas.
Evidencia: se celebran cumpleaños de mascotas en redes, pero al 17-oct no hay campaña de Halloween; las fechas dependen de la memoria</text>
    </textAnnotation>
    <textAnnotation id="A22">
      <text>Las consultas generadas siguen el AS-IS 1 (sin registro ni seguimiento)</text>
    </textAnnotation>
    <textAnnotation id="A23">
      <text>Dolor: no se mide cuántas ventas genera cada campaña</text>
    </textAnnotation>
    <association id="As21" sourceRef="R_Inicio" targetRef="A21" />
    <association id="As22" sourceRef="R_Responder" targetRef="A22" />
    <association id="As23" sourceRef="R_Fin" targetRef="A23" />
  </collaboration>
  <process id="Proc2_Peluditos" isExecutable="false">
    <laneSet id="LS2">
      <lane id="L2_Emprendedora" name="Emprendedora">
        <flowNodeRef>R_Inicio</flowNodeRef>
        <flowNodeRef>R_Buscar</flowNodeRef>
        <flowNodeRef>R_Gw</flowNodeRef>
        <flowNodeRef>R_Publicar</flowNodeRef>
        <flowNodeRef>R_Mensajes</flowNodeRef>
        <flowNodeRef>R_Join</flowNodeRef>
        <flowNodeRef>R_Responder</flowNodeRef>
        <flowNodeRef>R_Fin</flowNodeRef>
      </lane>
    </laneSet>
    <dataStoreReference id="DS2_Chats" name="Chats e historial de redes sociales" />
    <startEvent id="R_Inicio" name="Recuerda una fecha especial" />
    <task id="R_Buscar" name="Buscar clientes anteriores en chats y seguidores">
      <property id="R_Buscar_prop" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA2">
        <sourceRef>DS2_Chats</sourceRef>
        <targetRef>R_Buscar_prop</targetRef>
      </dataInputAssociation>
    </task>
    <exclusiveGateway id="R_Gw" name="¿Cómo difundir?" />
    <task id="R_Publicar" name="Publicar promoción en redes sociales" />
    <task id="R_Mensajes" name="Enviar mensajes uno a uno por WhatsApp" />
    <exclusiveGateway id="R_Join" />
    <task id="R_Responder" name="Responder consultas de interesados" />
    <endEvent id="R_Fin" name="Campaña realizada" />
    <sequenceFlow id="rf1" sourceRef="R_Inicio" targetRef="R_Buscar" />
    <sequenceFlow id="rf2" sourceRef="R_Buscar" targetRef="R_Gw" />
    <sequenceFlow id="rf3" name="Público general" sourceRef="R_Gw" targetRef="R_Publicar" />
    <sequenceFlow id="rf4" name="Clientes conocidos" sourceRef="R_Gw" targetRef="R_Mensajes" />
    <sequenceFlow id="rf5" sourceRef="R_Publicar" targetRef="R_Join" />
    <sequenceFlow id="rf6" sourceRef="R_Mensajes" targetRef="R_Join" />
    <sequenceFlow id="rf7" sourceRef="R_Join" targetRef="R_Responder" />
    <sequenceFlow id="rf8" sourceRef="R_Responder" targetRef="R_Fin" />
  </process>
  <bpmndi:BPMNDiagram id="D2">
    <bpmndi:BPMNPlane id="PL2" bpmnElement="Colab_ASIS2">
      <bpmndi:BPMNShape id="P2_Peluditos_di" bpmnElement="P2_Peluditos" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1250" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_Emprendedora_di" bpmnElement="L2_Emprendedora" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="1220" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS2_Chats_di" bpmnElement="DS2_Chats">
        <dc:Bounds x="375" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="357" y="375" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_Inicio_di" bpmnElement="R_Inicio">
