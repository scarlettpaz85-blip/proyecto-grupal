        <bpmndi:BPMNLabel>
          <dc:Bounds x="1084" y="248" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="rf1_di" bpmnElement="rf1">
        <di:waypoint x="288" y="230" />
        <di:waypoint x="340" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="rf2_di" bpmnElement="rf2">
        <di:waypoint x="460" y="230" />
