        <di:waypoint x="1030" y="230" />
        <di:waypoint x="1090" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P2_Clientes_di" bpmnElement="P2_Clientes" isHorizontal="true">
        <dc:Bounds x="160" y="470" width="1250" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A21_di" bpmnElement="A21">
        <dc:Bounds x="220" y="60" width="254" height="115" />
