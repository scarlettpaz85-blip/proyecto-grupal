      <bpmndi:BPMNShape id="R_Gw_di" bpmnElement="R_Gw" isMarkerVisible="true">
        <dc:Bounds x="510" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="494" y="255" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_Publicar_di" bpmnElement="R_Publicar">
        <dc:Bounds x="620" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_Mensajes_di" bpmnElement="R_Mensajes">
        <dc:Bounds x="620" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_Join_di" bpmnElement="R_Join" isMarkerVisible="true">
        <dc:Bounds x="800" y="205" width="50" height="50" />
