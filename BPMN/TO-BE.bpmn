<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://peluditospetchile.cl/bpmn">

  <process id="peluditosLead" name="Peluditos Pet Chile - Gestión de leads (TO-BE v3)" isExecutable="true">
    <documentation>Proceso 1 – Gestión de leads. Ejecutable en Flowable OSS 7.2. Las tareas de usuario se completan desde la interfaz propia (Proyecto-UI). Las tareas de servicio son External Worker Tasks atendidas por Proyecto-Worker, que invoca a Proyecto-WS. v3 (Entrega 3): el motivo de no compra se registra en una tarea propia antes de cerrar el lead.</documentation>

    <startEvent id="inicio" name="Consulta recibida"/>
    <sequenceFlow id="f1" sourceRef="inicio" targetRef="registrarLead"/>

    <userTask id="registrarLead" name="Registrar y clasificar lead">
      <documentation>La emprendedora registra los datos del interesado y clasifica el servicio requerido. Variables: nombre, telefono, correo, canal, interes, servicioRequerido.</documentation>
    </userTask>
    <sequenceFlow id="f2" sourceRef="registrarLead" targetRef="procesarWS"/>

    <serviceTask id="procesarWS" name="Registrar lead en el sistema" flowable:type="external-worker" flowable:topic="peluditos-lead-topic">
      <documentation>Automática. External worker: POST /api/leads. Devuelve leadId y registrado.</documentation>
    </serviceTask>
    <sequenceFlow id="f3" sourceRef="procesarWS" targetRef="realizarSeguimiento"/>

    <userTask id="realizarSeguimiento" name="Realizar seguimiento">
      <documentation>La emprendedora contacta al interesado e indica si compró. Variable: compro (boolean, obligatorio).</documentation>
    </userTask>
    <sequenceFlow id="f4" sourceRef="realizarSeguimiento" targetRef="gwCompro"/>

    <exclusiveGateway id="gwCompro" name="¿Compró?" default="fNo"/>
    <sequenceFlow id="fSi" name="Sí" sourceRef="gwCompro" targetRef="cerrarConvertido">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${compro == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNo" name="No" sourceRef="gwCompro" targetRef="registrarMotivo"/>

    <!-- Rama "Sí" -->
    <serviceTask id="cerrarConvertido" name="Registrar lead convertido" flowable:type="external-worker" flowable:topic="peluditos-cierre-topic">
      <documentation>Automática. External worker: PUT /api/leads/{leadId}/cierre con compro=true. El lead queda "Convertido" y se registra como cliente.</documentation>
    </serviceTask>
    <sequenceFlow id="f5" sourceRef="cerrarConvertido" targetRef="gestionarPedido"/>

    <userTask id="gestionarPedido" name="Gestionar pedido">
      <documentation>La emprendedora coordina el pedido según el servicio requerido. Variable opcional: notaPedido.</documentation>
    </userTask>
    <sequenceFlow id="f6" sourceRef="gestionarPedido" targetRef="finConvertido"/>
    <endEvent id="finConvertido" name="Lead convertido en cliente"/>

    <!-- Rama "No" -->
    <userTask id="registrarMotivo" name="Registrar motivo de no compra">
      <documentation>La emprendedora registra por qué el interesado no compró. Variables: motivoNoCompra (obligatorio: Precio, Fecha no disponible, Sin respuesta, Compró en otro lugar, Otro) y comentarioNoCompra (opcional).</documentation>
    </userTask>
    <sequenceFlow id="f7" sourceRef="registrarMotivo" targetRef="cerrarNoConvertido"/>

    <serviceTask id="cerrarNoConvertido" name="Registrar lead no convertido" flowable:type="external-worker" flowable:topic="peluditos-cierre-topic">
      <documentation>Automática. External worker: PUT /api/leads/{leadId}/cierre con compro=false, motivoNoCompra y comentarioNoCompra. El lead queda "No convertido".</documentation>
    </serviceTask>
    <sequenceFlow id="f8" sourceRef="cerrarNoConvertido" targetRef="finNoConvertido"/>
    <endEvent id="finNoConvertido" name="Lead no convertido (motivo registrado)"/>
  </process>

  <bpmndi:BPMNDiagram id="diagrama_peluditosLead">
    <bpmndi:BPMNPlane id="plano_peluditosLead" bpmnElement="peluditosLead">
      <bpmndi:BPMNShape id="s_inicio" bpmnElement="inicio"><omgdc:Bounds x="40" y="152" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_registrarLead" bpmnElement="registrarLead"><omgdc:Bounds x="120" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_procesarWS" bpmnElement="procesarWS"><omgdc:Bounds x="280" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_realizarSeguimiento" bpmnElement="realizarSeguimiento"><omgdc:Bounds x="440" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gwCompro" bpmnElement="gwCompro" isMarkerVisible="true"><omgdc:Bounds x="600" y="145" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cerrarConvertido" bpmnElement="cerrarConvertido"><omgdc:Bounds x="700" y="30" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gestionarPedido" bpmnElement="gestionarPedido"><omgdc:Bounds x="860" y="30" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_finConvertido" bpmnElement="finConvertido"><omgdc:Bounds x="1030" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_registrarMotivo" bpmnElement="registrarMotivo"><omgdc:Bounds x="700" y="230" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cerrarNoConvertido" bpmnElement="cerrarNoConvertido"><omgdc:Bounds x="860" y="230" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_finNoConvertido" bpmnElement="finNoConvertido"><omgdc:Bounds x="1030" y="252" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><omgdi:waypoint x="76" y="170"/><omgdi:waypoint x="120" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><omgdi:waypoint x="240" y="170"/><omgdi:waypoint x="280" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3"><omgdi:waypoint x="400" y="170"/><omgdi:waypoint x="440" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4"><omgdi:waypoint x="560" y="170"/><omgdi:waypoint x="600" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fSi" bpmnElement="fSi"><omgdi:waypoint x="625" y="145"/><omgdi:waypoint x="625" y="70"/><omgdi:waypoint x="700" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fNo" bpmnElement="fNo"><omgdi:waypoint x="625" y="195"/><omgdi:waypoint x="625" y="270"/><omgdi:waypoint x="700" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5"><omgdi:waypoint x="820" y="70"/><omgdi:waypoint x="860" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6"><omgdi:waypoint x="980" y="70"/><omgdi:waypoint x="1030" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f7" bpmnElement="f7"><omgdi:waypoint x="820" y="270"/><omgdi:waypoint x="860" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f8" bpmnElement="f8"><omgdi:waypoint x="980" y="270"/><omgdi:waypoint x="1030" y="270"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
