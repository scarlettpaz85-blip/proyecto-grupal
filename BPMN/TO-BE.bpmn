<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://peluditospetchile.cl/bpmn">

  <process id="peluditosLead" name="Peluditos Pet Chile - Gestión de leads (TO-BE OSS)" isExecutable="true">
    <documentation>Proceso TO-BE ejecutable en Flowable OSS 7.2. Las tareas de usuario se completan desde la interfaz propia (Proyecto-UI). Las tareas de servicio son External Worker Tasks atendidas por Proyecto-Worker, que invoca a Proyecto-WS.</documentation>

    <startEvent id="inicio" name="Consulta recibida"/>
    <sequenceFlow id="f1" sourceRef="inicio" targetRef="registrarLead"/>

    <userTask id="registrarLead" name="Registrar y clasificar lead">
      <documentation>La emprendedora revisa los datos del interesado (nombre, contacto, canal, interés) y clasifica el servicio requerido. Variables: nombre, telefono, correo, canal, interes, servicioRequerido.</documentation>
    </userTask>
    <sequenceFlow id="f2" sourceRef="registrarLead" targetRef="procesarWS"/>

    <serviceTask id="procesarWS" name="Registrar lead en el sistema" flowable:type="external-worker" flowable:topic="peluditos-lead-topic">
      <documentation>External worker: POST /api/leads. Devuelve leadId y registrado.</documentation>
    </serviceTask>
    <sequenceFlow id="f3" sourceRef="procesarWS" targetRef="realizarSeguimiento"/>

    <userTask id="realizarSeguimiento" name="Realizar seguimiento">
      <documentation>La emprendedora contacta al interesado y registra el resultado. Variables: compro (boolean), motivoNoCompra (si no compró).</documentation>
    </userTask>
    <sequenceFlow id="f4" sourceRef="realizarSeguimiento" targetRef="cerrarLead"/>

    <serviceTask id="cerrarLead" name="Registrar cierre del lead" flowable:type="external-worker" flowable:topic="peluditos-cierre-topic">
      <documentation>External worker: PUT /api/leads/{leadId}/cierre con compro y motivoNoCompra.</documentation>
    </serviceTask>
    <sequenceFlow id="f5" sourceRef="cerrarLead" targetRef="gwCompro"/>

    <exclusiveGateway id="gwCompro" name="¿Compró?" default="fNo"/>
    <sequenceFlow id="fSi" name="Sí" sourceRef="gwCompro" targetRef="gestionarPedido">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${compro == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNo" name="No" sourceRef="gwCompro" targetRef="finNoConvertido"/>

    <userTask id="gestionarPedido" name="Gestionar pedido">
      <documentation>La emprendedora coordina el pedido según el servicio requerido (repostería, baños o repuestos).</documentation>
    </userTask>
    <sequenceFlow id="f6" sourceRef="gestionarPedido" targetRef="finConvertido"/>

    <endEvent id="finConvertido" name="Lead convertido en cliente"/>
    <endEvent id="finNoConvertido" name="Lead no convertido"/>
  </process>

  <bpmndi:BPMNDiagram id="diagrama_peluditosLead">
    <bpmndi:BPMNPlane id="plano_peluditosLead" bpmnElement="peluditosLead">
      <bpmndi:BPMNShape id="s_inicio" bpmnElement="inicio"><omgdc:Bounds x="40" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_registrarLead" bpmnElement="registrarLead"><omgdc:Bounds x="120" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_procesarWS" bpmnElement="procesarWS"><omgdc:Bounds x="280" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_realizarSeguimiento" bpmnElement="realizarSeguimiento"><omgdc:Bounds x="440" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cerrarLead" bpmnElement="cerrarLead"><omgdc:Bounds x="600" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gwCompro" bpmnElement="gwCompro" isMarkerVisible="true"><omgdc:Bounds x="760" y="135" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gestionarPedido" bpmnElement="gestionarPedido"><omgdc:Bounds x="860" y="40" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_finConvertido" bpmnElement="finConvertido"><omgdc:Bounds x="1030" y="62" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_finNoConvertido" bpmnElement="finNoConvertido"><omgdc:Bounds x="1030" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><omgdi:waypoint x="76" y="160"/><omgdi:waypoint x="120" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><omgdi:waypoint x="240" y="160"/><omgdi:waypoint x="280" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3"><omgdi:waypoint x="400" y="160"/><omgdi:waypoint x="440" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4"><omgdi:waypoint x="560" y="160"/><omgdi:waypoint x="600" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5"><omgdi:waypoint x="720" y="160"/><omgdi:waypoint x="760" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fSi" bpmnElement="fSi"><omgdi:waypoint x="785" y="135"/><omgdi:waypoint x="785" y="80"/><omgdi:waypoint x="860" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fNo" bpmnElement="fNo"><omgdi:waypoint x="785" y="185"/><omgdi:waypoint x="785" y="250"/><omgdi:waypoint x="1030" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6"><omgdi:waypoint x="980" y="80"/><omgdi:waypoint x="1030" y="80"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
