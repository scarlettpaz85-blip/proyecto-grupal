# Configuración de Proyecto-UI (Peluditos Pet Chile)
# Copiar este archivo como .env y completar los valores. El .env NO se sube al repositorio.

# Vacío = rutas relativas (/api y /flowable-rest/service) a través del proxy de Vite.
# Es lo recomendado cuando la interfaz, Flowable y el WS corren en el mismo servidor.
VITE_API_BASE_URL=
VITE_FLOWABLE_BASE_URL=

# Usuario y contraseña de la API REST de Flowable (la contraseña no tiene valor por defecto)
VITE_FLOWABLE_USER=rest-admin
VITE_FLOWABLE_PASSWORD=CAMBIAR_POR_SECRETO_REAL

# Destinos del proxy de Vite (npm run dev y npm run preview)
VITE_FLOWABLE_TARGET=http://localhost:8080
VITE_WS_TARGET=http://localhost:8081

# Dirección pública de la interfaz (ej. http://IP_DEL_SERVIDOR:3000)
VITE_UI_PUBLIC_ORIGIN=http://localhost:3000
