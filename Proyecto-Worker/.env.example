# Copiar a .env y completar en el servidor. No subir .env al repositorio.
# FLOWABLE_URL debe terminar en /flowable-rest (sin /service)
FLOWABLE_URL=http://127.0.0.1:8080/flowable-rest
# WS_URL debe ser la base /api (sin /leads ni /oportunidades)
WS_URL=http://127.0.0.1:8081/api
WORKER_ID=peluditos-worker
FLOWABLE_USER=rest-admin
FLOWABLE_PASSWORD=test
# Alternativa si la instancia usa token Bearer:
FLOWABLE_TOKEN=
